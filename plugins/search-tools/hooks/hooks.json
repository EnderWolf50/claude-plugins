{
  "description": "tgrep serve lifecycle (SessionStart start / SessionEnd stop) and a Bash guard: grep only as a pipe filter, rg for files",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/tgrep-serve.sh\" start",
            "timeout": 20,
            "statusMessage": "tgrep serve check"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/tgrep-serve.sh\" stop",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/grep-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
