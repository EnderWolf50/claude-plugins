{
  "description": "Deny whole-tree git staging (git add -A/., git commit -a) chezmoi apply --force without a target, and on Windows a doubled backslash the Bash tool would halve, naming the narrower command",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/bash-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/powershell-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
