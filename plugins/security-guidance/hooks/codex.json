{
  "hooks": {
    "PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "uv run --no-project --script \"${PLUGIN_ROOT}/scripts/codex.py\"", "timeout": 15}]}],
    "PostToolUse": [
      {"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "uv run --no-project --script \"${PLUGIN_ROOT}/scripts/codex.py\"", "timeout": 15}]},
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "uv run --no-project --script \"${PLUGIN_ROOT}/scripts/codex.py\"", "async": true, "timeout": 600}]}
    ]
  }
}
